# Clima-Cast Backend Environment Variables - Example

# Database Configuration
# Format: postgresql+psycopg://user:password@localhost:5432/db_name
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/climacast

# JWT Authentication
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenWeather API Key
# Register at openweathermap.org
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:5173
