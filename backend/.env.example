# Clima-Cast Backend Environment Variables - Example

# Database Configuration
# Format: mysql+mysqlconnector://user:password@localhost:3306/db_name
DATABASE_URL=mysql+mysqlconnector://user:password@localhost:3306/climacast_db

# JWT Authentication
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys (Future Phases)
WEATHER_API_KEY=your_openweathermap_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:5173
