# Clima-Cast Backend Environment Variables - Example

# Database Configuration
# PostgreSQL is the primary database.
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/climacast

# Existing database used only to create DATABASE_URL's database when it is missing.
POSTGRES_MAINTENANCE_DB=postgres

# When true, local development falls back to backend/climacast.db if PostgreSQL is unavailable.
ENABLE_SQLITE_FALLBACK=true

# JWT Authentication
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenWeather API Key
# Register at openweathermap.org
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:5173
